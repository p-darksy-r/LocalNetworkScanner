<Window x:Class="LocalNetworkScanner.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:infra="clr-namespace:LocalNetworkScanner.Wpf.Infrastructure"
        Title="Local Network Scanner"
        Width="1440"
        Height="880"
        MinWidth="760"
        MinHeight="500"
        Background="{DynamicResource WindowBackgroundBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        TextOptions.TextFormattingMode="Display"
        WindowStartupLocation="CenterScreen"
        Loaded="OnLoaded"
        Closing="OnClosing"
        PreviewKeyDown="OnPreviewKeyDown"
        Validation.Error="OnInputValidationError"
        AutomationProperties.Name="Local Network Scanner">
    <Window.Resources>
        <Style x:Key="ValidatedNumericTextBoxStyle"
               TargetType="{x:Type TextBox}"
               BasedOn="{StaticResource {x:Type TextBox}}">
            <Style.Triggers>
                <Trigger Property="Validation.HasError" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
                    <Setter Property="BorderThickness" Value="2" />
                    <Setter Property="ToolTip"
                            Value="{Binding RelativeSource={RelativeSource Self}, Path=(Validation.Errors)[0].ErrorContent}" />
                    <Setter Property="AutomationProperties.HelpText"
                            Value="{Binding RelativeSource={RelativeSource Self}, Path=(Validation.Errors)[0].ErrorContent}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="2,0,2,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock FontFamily="Segoe UI Variable Display, Segoe UI"
                           FontSize="27"
                           FontWeight="SemiBold"
                           Text="Local Network Scanner" />
                <TextBlock Margin="0,3,0,0"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Text="Descoberta multicamada, inventário e segurança da tua rede local" />
            </StackPanel>
            <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                <ToggleButton IsChecked="{Binding IsAdvancedMode, Mode=TwoWay}"
                              Content="{Binding ModeLabel}"
                              IsEnabled="{Binding CanEditScanSettings}"
                              AutomationProperties.Name="Personalizar parâmetros técnicos do scan"
                              AutomationProperties.HelpText="Mostra ou oculta os parâmetros técnicos que substituem o perfil escolhido." />
                <TextBlock Margin="0,5,0,0"
                           HorizontalAlignment="Right"
                           FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Text="F5 iniciar · Esc cancelar · Ctrl+F procurar · Ctrl+E exportar" />
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Disabled">
        <Border MinWidth="980" Style="{StaticResource CardBorderStyle}" Padding="16,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2.1*" MinWidth="290" />
                    <ColumnDefinition Width="1.25*" MinWidth="190" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Label Grid.Row="0" Grid.Column="0" Content="Interface de rede" />
                <Label Grid.Row="0" Grid.Column="1" Margin="12,0,0,0" Content="Rede / CIDR" />

                <ComboBox Grid.Row="1"
                          Grid.Column="0"
                          ItemsSource="{Binding NetworkInterfaces}"
                          SelectedItem="{Binding SelectedNetworkInterface, Mode=TwoWay}"
                          DisplayMemberPath="DisplayName"
                          IsEnabled="{Binding CanEditScanSettings}"
                          AutomationProperties.Name="Interface de rede"
                          AutomationProperties.HelpText="Interface IPv4 usada como referência para o scan." />
                <TextBox Grid.Row="1"
                         Grid.Column="1"
                         Margin="12,0,0,0"
                         Text="{Binding NetworkCidr, UpdateSourceTrigger=PropertyChanged}"
                         IsEnabled="{Binding CanEditScanSettings}"
                         ToolTip="Exemplo: 192.168.1.0/24. Apenas redes privadas são aceites."
                         AutomationProperties.Name="Rede em formato CIDR"
                         AutomationProperties.HelpText="Introduz uma rede IPv4 privada, por exemplo 192.168.1.0 barra 24." />
                <Button Grid.Row="1"
                        Grid.Column="2"
                        Margin="12,0,0,0"
                        Command="{Binding RefreshInterfacesCommand}"
                        Content="Atualizar"
                        ToolTip="Voltar a detetar interfaces de rede"
                        AutomationProperties.Name="Atualizar interfaces de rede" />
                <Button Grid.Row="1"
                        Grid.Column="3"
                        Margin="12,0,0,0"
                        MinWidth="116"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding ScanCommand}"
                        Content="_Iniciar scan"
                        AutomationProperties.Name="Iniciar scan"
                        AutomationProperties.HelpText="Inicia o scan da rede selecionada. Atalho F5." />
                <Button Grid.Row="1"
                        Grid.Column="4"
                        Margin="8,0,0,0"
                        MinWidth="100"
                        Style="{StaticResource DangerButtonStyle}"
                        Command="{Binding CancelCommand}"
                        Content="_Cancelar"
                        Visibility="{Binding IsScanning, Converter={StaticResource BooleanToVisibilityConverter}}"
                        AutomationProperties.Name="Cancelar scan"
                        AutomationProperties.HelpText="Cancela o scan em curso. Atalho Escape." />

                <Grid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="5" Margin="0,9,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2.1*" />
                        <ColumnDefinition Width="1.25*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding SelectedInterfaceSummary}"
                               FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="1"
                               Margin="12,0,0,0"
                               Text="{Binding SelectedInterfaceVlan}"
                               FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextTrimming="CharacterEllipsis" />
                </Grid>

                <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="5" Margin="0,13,0,0">
                    <TextBlock FontSize="12"
                               FontWeight="SemiBold"
                               Text="Escolhe o tipo de scan" />
                    <TextBlock Margin="0,2,0,7"
                               FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="Podes começar pelo perfil Normal. O alcance real também depende do tamanho e da resposta da rede." />
                    <ListBox ItemsSource="{Binding Profiles}"
                             SelectedItem="{Binding SelectedProfile, Mode=TwoWay}"
                             IsEnabled="{Binding CanEditScanSettings}"
                             Background="Transparent"
                             BorderThickness="0"
                             KeyboardNavigation.DirectionalNavigation="Contained"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Disabled"
                             AutomationProperties.Name="Tipo de scan"
                             AutomationProperties.HelpText="Escolhe entre scan Rápido, Normal recomendado ou Avançado.">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="3" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="{x:Type ListBoxItem}">
                                <Setter Property="Margin" Value="0,0,8,0" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="FocusVisualStyle" Value="{StaticResource AccessibleFocusVisualStyle}" />
                                <Setter Property="AutomationProperties.Name" Value="{Binding DisplayName, StringFormat=Perfil de scan {0}}" />
                                <Setter Property="AutomationProperties.HelpText" Value="{Binding Description}" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                            <Border x:Name="ProfileCard"
                                                    MinHeight="94"
                                                    Padding="12,9"
                                                    Background="{DynamicResource SurfaceMutedBrush}"
                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="7">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="ProfileCard" Property="Background" Value="{DynamicResource SelectionBrush}" />
                                                    <Setter TargetName="ProfileCard" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                    <Setter TargetName="ProfileCard" Property="BorderThickness" Value="2" />
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ProfileCard" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter TargetName="ProfileCard" Property="Opacity" Value="0.55" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock FontSize="15" FontWeight="SemiBold" Text="{Binding DisplayName}" />
                                        <Border Grid.Column="1"
                                                Margin="8,0,0,0"
                                                Padding="6,2"
                                                VerticalAlignment="Center"
                                                Background="{DynamicResource SurfaceBrush}"
                                                CornerRadius="8">
                                            <TextBlock FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource AccentDarkBrush}" Text="{Binding Badge}" />
                                        </Border>
                                    </Grid>
                                    <TextBlock Grid.Row="1"
                                               Margin="0,4,0,0"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               Text="{Binding Description}"
                                               TextWrapping="Wrap" />
                                    <WrapPanel Grid.Row="2" Margin="0,6,0,0">
                                        <TextBlock Margin="0,0,12,0" FontSize="10" FontWeight="SemiBold" Text="{Binding Scope}" />
                                        <TextBlock FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding Duration, StringFormat=Tempo: {0}}" />
                                    </WrapPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Grid>
        </Border>
        </ScrollViewer>

        <Expander Grid.Row="2"
                  Margin="0,10,0,0"
                  IsExpanded="{Binding IsAdvancedMode, Mode=TwoWay}"
                  IsEnabled="{Binding CanEditScanSettings}"
                  AutomationProperties.Name="Parâmetros técnicos personalizados do scan">
            <Expander.Header>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Parâmetros técnicos personalizados" />
                    <TextBlock Margin="10,0,0,0"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource DangerBrush}"
                               Text="{Binding InputValidationMessage}"
                               Visibility="{Binding HasBlockingInputValidationErrors, Converter={StaticResource BooleanToVisibilityConverter}}"
                               AutomationProperties.LiveSetting="Assertive" />
                </StackPanel>
            </Expander.Header>
            <ScrollViewer MaxHeight="210"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto">
            <Border MinWidth="980" Margin="0,7,0,0" Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <UniformGrid Columns="7">
                        <StackPanel Margin="0,0,10,0">
                            <Label Content="Portas" />
                            <TextBox Text="{Binding CustomPorts, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Vazio usa o perfil. Exemplos: 22,80,443; 1-1024; quick; all."
                                     AutomationProperties.Name="Portas personalizadas" />
                        </StackPanel>
                        <StackPanel Margin="0,0,10,0">
                            <Label Content="Máx. endereços" />
                            <TextBox Style="{StaticResource ValidatedNumericTextBoxStyle}"
                                     AutomationProperties.Name="Máximo de endereços">
                                <TextBox.Text>
                                    <Binding Path="MaximumHosts"
                                             UpdateSourceTrigger="PropertyChanged"
                                             NotifyOnValidationError="True">
                                        <Binding.ValidationRules>
                                            <infra:IntegerRangeValidationRule FieldName="Máximo de endereços"
                                                                              Minimum="1"
                                                                              Maximum="65536"
                                                                              ValidationStep="RawProposedValue" />
                                        </Binding.ValidationRules>
                                    </Binding>
                                </TextBox.Text>
                            </TextBox>
                        </StackPanel>
                        <StackPanel Margin="0,0,10,0">
                            <Label Content="Hosts paralelos" />
                            <TextBox Style="{StaticResource ValidatedNumericTextBoxStyle}"
                                     AutomationProperties.Name="Concorrência máxima por host">
                                <TextBox.Text>
                                    <Binding Path="MaximumHostConcurrency"
                                             UpdateSourceTrigger="PropertyChanged"
                                             NotifyOnValidationError="True">
                                        <Binding.ValidationRules>
                                            <infra:IntegerRangeValidationRule FieldName="Hosts paralelos"
                                                                              Minimum="1"
                                                                              Maximum="512"
                                                                              ValidationStep="RawProposedValue" />
                                        </Binding.ValidationRules>
                                    </Binding>
                                </TextBox.Text>
                            </TextBox>
                        </StackPanel>
                        <StackPanel Margin="0,0,10,0">
                            <Label Content="Portas paralelas" />
                            <TextBox Style="{StaticResource ValidatedNumericTextBoxStyle}"
                                     AutomationProperties.Name="Concorrência máxima por porta">
                                <TextBox.Text>
                                    <Binding Path="MaximumPortConcurrency"
                                             UpdateSourceTrigger="PropertyChanged"
                                             NotifyOnValidationError="True">
                                        <Binding.ValidationRules>
                                            <infra:IntegerRangeValidationRule FieldName="Portas paralelas"
                                                                              Minimum="1"
                                                                              Maximum="512"
                                                                              ValidationStep="RawProposedValue" />
                                        </Binding.ValidationRules>
                                    </Binding>
                                </TextBox.Text>
                            </TextBox>
                        </StackPanel>
                        <StackPanel Margin="0,0,10,0">
                            <Label Content="Ping (ms)" />
                            <TextBox Style="{StaticResource ValidatedNumericTextBoxStyle}"
                                     AutomationProperties.Name="Timeout ICMP em milissegundos">
                                <TextBox.Text>
                                    <Binding Path="PingTimeoutMs"
                                             UpdateSourceTrigger="PropertyChanged"
                                             NotifyOnValidationError="True">
                                        <Binding.ValidationRules>
                                            <infra:IntegerRangeValidationRule FieldName="Timeout de ping"
                                                                              Minimum="50"
                                                                              Maximum="30000"
                                                                              ValidationStep="RawProposedValue" />
                                        </Binding.ValidationRules>
                                    </Binding>
                                </TextBox.Text>
                            </TextBox>
                        </StackPanel>
                        <StackPanel Margin="0,0,10,0">
                            <Label Content="TCP (ms)" />
                            <TextBox Style="{StaticResource ValidatedNumericTextBoxStyle}"
                                     AutomationProperties.Name="Timeout TCP em milissegundos">
                                <TextBox.Text>
                                    <Binding Path="ConnectTimeoutMs"
                                             UpdateSourceTrigger="PropertyChanged"
                                             NotifyOnValidationError="True">
                                        <Binding.ValidationRules>
                                            <infra:IntegerRangeValidationRule FieldName="Timeout TCP"
                                                                              Minimum="50"
                                                                              Maximum="30000"
                                                                              ValidationStep="RawProposedValue" />
                                        </Binding.ValidationRules>
                                    </Binding>
                                </TextBox.Text>
                            </TextBox>
                        </StackPanel>
                        <StackPanel>
                            <Label Content="Descoberta (ms)" />
                            <TextBox Style="{StaticResource ValidatedNumericTextBoxStyle}"
                                     AutomationProperties.Name="Timeout multicast em milissegundos">
                                <TextBox.Text>
                                    <Binding Path="DiscoveryTimeoutMs"
                                             UpdateSourceTrigger="PropertyChanged"
                                             NotifyOnValidationError="True">
                                        <Binding.ValidationRules>
                                            <infra:IntegerRangeValidationRule FieldName="Timeout de descoberta"
                                                                              Minimum="100"
                                                                              Maximum="30000"
                                                                              ValidationStep="RawProposedValue" />
                                        </Binding.ValidationRules>
                                    </Binding>
                                </TextBox.Text>
                            </TextBox>
                        </StackPanel>
                    </UniformGrid>

                    <WrapPanel Margin="0,13,0,0">
                        <CheckBox Margin="0,3,20,3"
                                  IsChecked="{Binding EnableIcmp}"
                                  Content="ICMP / ping"
                                  AutomationProperties.Name="Ativar descoberta ICMP" />
                        <CheckBox Margin="0,3,20,3"
                                  IsChecked="{Binding EnableTcpDiscovery}"
                                  Content="Descoberta TCP"
                                  AutomationProperties.Name="Ativar descoberta TCP" />
                        <CheckBox Margin="0,3,20,3"
                                  IsChecked="{Binding EnableArp}"
                                  Content="Resolver MAC por ARP"
                                  AutomationProperties.Name="Ativar resolução ARP" />
                        <CheckBox Margin="0,3,20,3"
                                  IsChecked="{Binding EnableMulticastDiscovery}"
                                  Content="mDNS, SSDP e WSD"
                                  AutomationProperties.Name="Ativar descoberta multicast" />
                        <CheckBox Margin="0,3,20,3"
                                  IsChecked="{Binding EnableNetBiosDiscovery}"
                                  Content="NetBIOS"
                                  AutomationProperties.Name="Ativar descoberta NetBIOS" />
                        <CheckBox Margin="0,3,20,3"
                                  IsChecked="{Binding EnableServiceProbes}"
                                  Content="Banners e TLS"
                                  AutomationProperties.Name="Ativar análise de serviços e TLS" />
                        <CheckBox Margin="0,3,20,3"
                                  IsChecked="{Binding EnableSnmpTopology}"
                                  Content="Topologia por SNMP"
                                  AutomationProperties.Name="Ativar consulta SNMP ao switch" />
                        <CheckBox Margin="0,3,20,3"
                                  IsChecked="{Binding EnableHistory}"
                                  Content="Guardar e comparar histórico local"
                                  ToolTip="Guarda localmente o último snapshot desta rede para detetar alterações no scan seguinte."
                                  AutomationProperties.Name="Guardar e comparar histórico local"
                                  AutomationProperties.HelpText="O histórico fica apenas neste computador e pode ser apagado a qualquer momento." />
                    </WrapPanel>
                    <Grid Margin="0,10,0,0"
                          Visibility="{Binding EnableSnmpTopology, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.2*" />
                            <ColumnDefinition Width="1.2*" />
                            <ColumnDefinition Width="0.8*" />
                            <ColumnDefinition Width="2.8*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,10,0">
                            <Label Content="IP do switch SNMP" />
                            <TextBox Text="{Binding SnmpSwitchAddress, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="Endereço IP do switch SNMP" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,10,0">
                            <Label Content="Comunidade SNMP" />
                            <PasswordBox x:Name="SnmpCommunityPasswordBox"
                                         PasswordChanged="OnSnmpCommunityPasswordChanged"
                                         AutomationProperties.Name="Comunidade SNMP"
                                         AutomationProperties.HelpText="A comunidade é usada apenas durante esta sessão e não é guardada." />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="0,0,10,0">
                            <Label Content="Timeout (ms)" />
                            <TextBox Style="{StaticResource ValidatedNumericTextBoxStyle}"
                                     AutomationProperties.Name="Timeout SNMP em milissegundos">
                                <TextBox.Text>
                                    <Binding Path="SnmpTimeoutMs"
                                             UpdateSourceTrigger="PropertyChanged"
                                             NotifyOnValidationError="True">
                                        <Binding.ValidationRules>
                                            <infra:IntegerRangeValidationRule FieldName="Timeout SNMP"
                                                                              Minimum="100"
                                                                              Maximum="30000"
                                                                              ValidationStep="RawProposedValue" />
                                        </Binding.ValidationRules>
                                    </Binding>
                                </TextBox.Text>
                            </TextBox>
                        </StackPanel>
                        <TextBlock Grid.Column="3"
                                   VerticalAlignment="Bottom"
                                   Margin="0,0,0,8"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   Text="SNMP v2c consulta a FDB, a porta aprendida e o mapeamento de VLAN quando disponível. Uma entrada FDB pode ser um uplink/trunk e não confirma, por si só, a ligação física. A comunidade não é persistida." />
                    </Grid>
                    <DockPanel Margin="0,8,0,0" LastChildFill="True">
                        <Button DockPanel.Dock="Right"
                                 Margin="12,0,0,0"
                                 Style="{StaticResource CompactButtonStyle}"
                                 Command="{Binding UpdateOuiDatabaseCommand}"
                                 Content="↻  Verificar atualização IEEE"
                                 ToolTip="A base completa da release já está incorporada. Esta ação procura apenas atribuições publicadas posteriormente."
                                 AutomationProperties.Name="Verificar atualização opcional da base IEEE" />
                        <Button DockPanel.Dock="Right"
                                Margin="12,0,0,0"
                                Style="{StaticResource CompactButtonStyle}"
                                Command="{Binding ResetOuiDatabaseCommand}"
                                Content="Repor base incorporada"
                                ToolTip="Remove uma atualização local e volta à snapshot incluída nesta versão"
                                AutomationProperties.Name="Repor a base IEEE incorporada" />
                        <Button DockPanel.Dock="Right"
                                Margin="12,0,0,0"
                                Style="{StaticResource CompactButtonStyle}"
                                Command="{Binding DeleteHistoryCommand}"
                                Content="Apagar histórico"
                                ToolTip="Apaga os snapshots locais usados para comparar scans"
                                AutomationProperties.Name="Apagar todo o histórico local de scans" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentBrush}"
                                       TextWrapping="Wrap"
                                       Text="{Binding VendorDatabaseStatus}" />
                            <TextBlock Margin="0,2,0,0"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextWrapping="Wrap"
                                       Text="Aumentar a concorrência ou analisar todas as portas gera mais tráfego. Usa estas opções apenas em redes que administras." />
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </Border>
            </ScrollViewer>
        </Expander>

        <UniformGrid Grid.Row="3" Columns="5" Margin="0,10,0,10">
            <Border Margin="0,0,8,0" Style="{StaticResource CardBorderStyle}" Padding="14,11">
                <StackPanel>
                    <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Text="ENDEREÇOS ANALISADOS" />
                    <TextBlock Margin="0,3,0,0" FontSize="22" FontWeight="SemiBold" Text="{Binding ScannedCount, StringFormat={}{0:N0}}" />
                </StackPanel>
            </Border>
            <Border Margin="2,0,6,0" Style="{StaticResource CardBorderStyle}" Padding="14,11">
                <StackPanel>
                    <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Text="DISPOSITIVOS ONLINE" />
                    <TextBlock Margin="0,3,0,0" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource SuccessBrush}" Text="{Binding OnlineCount, StringFormat={}{0:N0}}" />
                </StackPanel>
            </Border>
            <Border Margin="4,0" Style="{StaticResource CardBorderStyle}" Padding="14,11">
                <StackPanel>
                    <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Text="NOVOS" />
                    <TextBlock Margin="0,3,0,0" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Text="{Binding NewCount, StringFormat={}{0:N0}}" />
                </StackPanel>
            </Border>
            <Border Margin="6,0,2,0" Style="{StaticResource CardBorderStyle}" Padding="14,11">
                <StackPanel>
                    <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Text="COM ALERTAS" />
                    <TextBlock Margin="0,3,0,0" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource DangerBrush}" Text="{Binding RiskCount, StringFormat={}{0:N0}}" />
                </StackPanel>
            </Border>
            <Border Margin="8,0,0,0" Style="{StaticResource CardBorderStyle}" Padding="14,11">
                <StackPanel>
                    <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Text="TEMPO DECORRIDO" />
                    <TextBlock Margin="0,3,0,0" FontSize="22" FontWeight="SemiBold" Text="{Binding ElapsedText}" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="400" />
                <ColumnDefinition Width="7" />
                <ColumnDefinition Width="300" MinWidth="270" MaxWidth="520" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ScrollViewer Grid.Row="0"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Disabled">
                    <Grid MinWidth="680" Margin="14,12,14,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <Grid>
                                <TextBox x:Name="SearchTextBox"
                                         Width="290"
                                         Padding="30,6,34,6"
                                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="Pesquisar dispositivos"
                                         AutomationProperties.HelpText="Filtra por nome, IP, MAC, entidade IEEE, tipo, porta ou protocolo." />
                                <TextBlock Margin="10,0,0,0"
                                           VerticalAlignment="Center"
                                           FontFamily="Segoe MDL2 Assets"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           IsHitTestVisible="False"
                                           Text="&#xE721;" />
                                <Button Width="28"
                                        Height="28"
                                        Margin="0,0,4,0"
                                        Padding="0"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource CompactButtonStyle}"
                                        Command="{Binding ClearSearchCommand}"
                                        Content="×"
                                        ToolTip="Limpar pesquisa"
                                        AutomationProperties.Name="Limpar pesquisa" />
                            </Grid>
                            <ComboBox Width="165"
                                      Margin="8,0,0,0"
                                      ItemsSource="{Binding Filters}"
                                      SelectedItem="{Binding SelectedFilter}"
                                      DisplayMemberPath="DisplayName"
                                      AutomationProperties.Name="Filtrar dispositivos por estado" />
                            <TextBlock Margin="12,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="{Binding VisibleDeviceCount, StringFormat={}{0:N0} visíveis}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button x:Name="OpenTopologyButton"
                                    Margin="4,0,12,0"
                                    Padding="10,5"
                                    Style="{StaticResource CompactButtonStyle}"
                                    Click="OnOpenTopologyClick"
                                    IsEnabled="{Binding HasTopologyMap}"
                                    ToolTip="Abre o mapa deste scan numa janela independente. Disponível após existirem resultados."
                                    ToolTipService.ShowOnDisabled="True"
                                    AutomationProperties.Name="Abrir topologia do scan"
                                    AutomationProperties.HelpText="Abre opcionalmente a topologia do scan atual numa janela separada. O botão fica disponível depois do scan.">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Margin="0,0,7,0"
                                               VerticalAlignment="Center"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="14"
                                               Text="&#xE968;" />
                                    <TextBlock VerticalAlignment="Center" Text="Abrir topologia" />
                                </StackPanel>
                            </Button>
                            <Button Margin="4,0"
                                    Style="{StaticResource CompactButtonStyle}"
                                    Command="{Binding ExportCsvCommand}"
                                    Content="CSV"
                                    ToolTip="Exportar CSV"
                                    AutomationProperties.Name="Exportar resultados em CSV" />
                            <Button Margin="4,0"
                                    Style="{StaticResource CompactButtonStyle}"
                                    Command="{Binding ExportJsonCommand}"
                                    Content="JSON"
                                    ToolTip="Exportar JSON"
                                    AutomationProperties.Name="Exportar resultados em JSON" />
                            <Button Margin="4,0"
                                    Style="{StaticResource CompactButtonStyle}"
                                    Command="{Binding ExportHtmlCommand}"
                                    Content="HTML"
                                    ToolTip="Exportar relatório HTML pronto a imprimir"
                                    AutomationProperties.Name="Exportar relatório em HTML" />
                            <Button Margin="4,0"
                                    Style="{StaticResource CompactButtonStyle}"
                                    Command="{Binding ExportSupportJsonCommand}"
                                    Content="Suporte"
                                    ToolTip="Criar um relatório JSON minimizado para diagnóstico. Revê-o antes de partilhar."
                                    AutomationProperties.Name="Criar relatório de suporte em JSON" />
                        </StackPanel>
                        <Button Grid.Column="2"
                                Margin="8,0,0,0"
                                Style="{StaticResource CompactButtonStyle}"
                                Command="{Binding ClearResultsCommand}"
                                Content="Limpar"
                                AutomationProperties.Name="Limpar resultados" />
                    </Grid>
                    </ScrollViewer>

                    <Grid Grid.Row="1" Margin="14,0,14,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentDarkBrush}"
                                   Text="{Binding ProgressPhase}" />
                        <ProgressBar Grid.Column="1"
                                     Height="7"
                                     Margin="12,0"
                                     VerticalAlignment="Center"
                                     Minimum="0"
                                     Maximum="100"
                                     Value="{Binding ProgressPercentage, Mode=OneWay}"
                                     IsIndeterminate="{Binding IsLoadingInterfaces}"
                                     AutomationProperties.Name="Progresso do scan" />
                        <TextBlock Grid.Column="2"
                                   VerticalAlignment="Center"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="{Binding ProgressPercentage, StringFormat={}{0:F0}%}" />
                    </Grid>

                    <Grid Grid.Row="2">
                        <DataGrid x:Name="DevicesDataGrid"
                                  ItemsSource="{Binding DevicesView}"
                                  SelectedItem="{Binding SelectedDevice, Mode=TwoWay}"
                                  PreviewMouseRightButtonDown="OnDevicesDataGridPreviewMouseRightButtonDown"
                                  IsReadOnly="True"
                                  FrozenColumnCount="3"
                                  AlternationCount="2"
                                  ClipboardCopyMode="ExcludeHeader"
                                  AutomationProperties.Name="Dispositivos encontrados"
                                  AutomationProperties.HelpText="Seleciona um dispositivo para consultar detalhes e ações.">
                            <DataGrid.ContextMenu>
                                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                    <MenuItem Header="Copiar IP" Command="{Binding CopyIpCommand}" />
                                    <MenuItem Header="Copiar MAC" Command="{Binding CopyMacCommand}" />
                                    <Separator />
                                    <MenuItem Header="Abrir interface Web" Command="{Binding OpenWebCommand}" />
                                    <MenuItem Header="Abrir no Explorador" Command="{Binding OpenExplorerCommand}" />
                                    <MenuItem Header="Ambiente de Trabalho Remoto" Command="{Binding RemoteDesktopCommand}" />
                                    <MenuItem Header="Wake-on-LAN" Command="{Binding WakeOnLanCommand}" />
                                    <Separator />
                                    <MenuItem Header="Ping" Command="{Binding PingCommand}" />
                                    <MenuItem Header="Tracert" Command="{Binding TracerouteCommand}" />
                                </ContextMenu>
                            </DataGrid.ContextMenu>
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Estado" Width="92" SortMemberPath="StatusText">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="8" Height="8" Margin="0,0,7,0">
                                                    <Ellipse.Style>
                                                        <Style TargetType="Ellipse">
                                                            <Setter Property="Fill" Value="{DynamicResource TextSecondaryBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                                                    <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Ellipse.Style>
                                                </Ellipse>
                                                <TextBlock VerticalAlignment="Center" Text="{Binding StatusText}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Dispositivo" Width="205" SortMemberPath="Hostname">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Margin="0,0,5,0"
                                                               Foreground="{DynamicResource WarningBrush}"
                                                               Text="★"
                                                               Visibility="{Binding IsFavorite, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                    <TextBlock FontWeight="SemiBold" Text="{Binding Hostname}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <TextBlock Margin="0,2,0,0" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding DeviceType}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="IP" Width="122" Binding="{Binding IpAddress, Mode=OneWay}" SortMemberPath="IpSortKey" />
                                <DataGridTemplateColumn Header="MAC / entidade IEEE" Width="190" SortMemberPath="MacAddress">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <TextBlock Text="{Binding MacAddress}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Margin="0,2,0,0" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding Manufacturer}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Ping" Width="78" Binding="{Binding ResponseTime, Mode=OneWay}" SortMemberPath="ResponseTimeSortKey" />
                                <DataGridTemplateColumn Header="Portas / serviços" Width="190" SortMemberPath="OpenPortCount">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding OpenPorts}" TextTrimming="CharacterEllipsis" ToolTip="{Binding OpenPorts}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Protocolos" Width="135" SortMemberPath="Protocols">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Protocols}" TextTrimming="CharacterEllipsis" ToolTip="Protocolos observados ou inferidos; não representa captura integral de pacotes." />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Risco" Width="92" SortMemberPath="RiskScore">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Padding="8,3"
                                                    HorizontalAlignment="Left"
                                                    Background="{Binding RiskLevel, Converter={StaticResource RiskToBrushConverter}}"
                                                    CornerRadius="10">
                                                <TextBlock FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Foreground="{Binding RiskLevel, Converter={StaticResource RiskToForegroundConverter}}"
                                                           Text="{Binding RiskDisplay}" />
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Rede / topologia" Width="235" SortMemberPath="Topology">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Topology}" TextTrimming="CharacterEllipsis" ToolTip="{Binding SwitchEvidence}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <Border Padding="30"
                                Background="{DynamicResource SurfaceBrush}"
                                IsHitTestVisible="False">
                            <Border.Style>
                                <Style TargetType="{x:Type Border}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Devices.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock HorizontalAlignment="Center"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="34"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Text="&#xE950;" />
                                <TextBlock Margin="0,12,0,0"
                                           HorizontalAlignment="Center"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Text="Ainda não existem resultados" />
                                <TextBlock Margin="0,5,0,0"
                                           MaxWidth="390"
                                           HorizontalAlignment="Center"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Text="Seleciona uma interface e inicia um scan. Os dispositivos aparecem aqui à medida que forem encontrados." />
                            </StackPanel>
                        </Border>

                        <Border Padding="30"
                                Background="{DynamicResource SurfaceBrush}"
                                Visibility="{Binding HasNoVisibleDevices, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock HorizontalAlignment="Center"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="32"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Text="&#xE721;" />
                                <TextBlock Margin="0,12,0,0"
                                           HorizontalAlignment="Center"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Text="Sem dispositivos correspondentes" />
                                <TextBlock Margin="0,5,0,0"
                                           MaxWidth="410"
                                           HorizontalAlignment="Center"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Text="A pesquisa ou o filtro atual ocultou todos os resultados deste scan." />
                                <Button Margin="0,13,0,0"
                                        HorizontalAlignment="Center"
                                        Style="{StaticResource CompactButtonStyle}"
                                        Command="{Binding ResetFiltersCommand}"
                                        Content="Repor pesquisa e filtro"
                                        AutomationProperties.Name="Repor pesquisa e filtro de dispositivos" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <StackPanel Grid.Row="3" Margin="14,7,14,10">
                        <Expander Header="{Binding DiagnosticSummary}"
                                  Visibility="{Binding HasDiagnostics, Converter={StaticResource BooleanToVisibilityConverter}}"
                                  AutomationProperties.Name="Diagnósticos estruturados do scan"
                                  AutomationProperties.HelpText="Cada diagnóstico identifica se a origem provável é o utilizador, a rede, o dispositivo ou a aplicação.">
                            <ItemsControl Margin="0,7,0,0" ItemsSource="{Binding Diagnostics}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,3"
                                                Padding="10,8"
                                                Background="{DynamicResource SurfaceMutedBrush}"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="6">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock FontFamily="Consolas"
                                                               FontSize="11"
                                                               FontWeight="Bold"
                                                               Foreground="{DynamicResource AccentDarkBrush}"
                                                               Text="{Binding Code}" />
                                                    <TextBlock Grid.Column="1"
                                                               Margin="9,0,0,0"
                                                               FontSize="11"
                                                               FontWeight="SemiBold"
                                                               Text="{Binding CategoryLabel}" />
                                                    <TextBlock Grid.Column="2"
                                                               HorizontalAlignment="Right"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                               Text="{Binding SeverityLabel}" />
                                                </Grid>
                                                <TextBlock Grid.Row="1"
                                                           Margin="0,4,0,0"
                                                           Text="{Binding Message}"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Grid.Row="2"
                                                           Margin="0,3,0,0"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           Text="{Binding RecommendedAction, StringFormat=Ação recomendada: {0}}"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Grid.Row="3"
                                                           Margin="0,3,0,0"
                                                           FontSize="10"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           Text="{Binding Target, StringFormat=Alvo: {0}}"
                                                           TextWrapping="Wrap"
                                                           Visibility="{Binding HasTarget, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Expander>

                        <Expander Margin="0,4,0,0"
                                  Header="Notas adicionais do resultado"
                                  Visibility="{Binding HasWarnings, Converter={StaticResource BooleanToVisibilityConverter}}"
                                  AutomationProperties.Name="Notas adicionais do resultado">
                            <ItemsControl Margin="0,7,0,0" ItemsSource="{Binding Warnings}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Margin="0,2"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource WarningBrush}"
                                                   Text="{Binding StringFormat=• {0}}"
                                                   TextWrapping="Wrap" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Expander>
                    </StackPanel>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1"
                          Width="7"
                          HorizontalAlignment="Stretch"
                          Background="Transparent"
                          ResizeBehavior="PreviousAndNext"
                          ResizeDirection="Columns"
                          ShowsPreview="True"
                          AutomationProperties.Name="Redimensionar painel de detalhes" />

            <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}" Padding="0">
                <Grid>
                    <Border Padding="26">
                        <Border.Style>
                            <Style TargetType="{x:Type Border}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedDevice}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock HorizontalAlignment="Center"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="30"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="&#xE77B;" />
                            <TextBlock Margin="0,12,0,0"
                                       HorizontalAlignment="Center"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Text="Seleciona um dispositivo" />
                            <TextBlock Margin="0,5,0,0"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="Os detalhes, serviços, segurança e ações aparecem neste painel." />
                        </StackPanel>
                    </Border>

                    <Grid Visibility="{Binding SelectedDevice, Converter={StaticResource NullToVisibilityConverter}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Margin="17,15,17,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock FontSize="18" FontWeight="SemiBold" Text="{Binding SelectedDevice.Hostname}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Margin="0,3,0,0" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding SelectedDevice.IpAddress}" />
                            </StackPanel>
                            <Border Grid.Column="1"
                                    Padding="9,4"
                                    VerticalAlignment="Center"
                                    Background="{Binding SelectedDevice.RiskLevel, Converter={StaticResource RiskToBrushConverter}}"
                                    CornerRadius="11">
                                <TextBlock FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{Binding SelectedDevice.RiskLevel, Converter={StaticResource RiskToForegroundConverter}}"
                                           Text="{Binding SelectedDevice.RiskDisplay, StringFormat=Risco {0}}" />
                            </Border>
                        </Grid>

                        <TabControl Grid.Row="1" Margin="8,0,8,8" AutomationProperties.Name="Detalhes do dispositivo">
                            <TabItem Header="Resumo">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel Margin="10">
                                        <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Text="IDENTIDADE" />
                                        <Grid Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Margin="0,4" Foreground="{DynamicResource TextSecondaryBrush}" Text="Tipo" />
                                            <TextBlock Grid.Column="1" Margin="0,4" Text="{Binding SelectedDevice.DeviceType}" TextWrapping="Wrap" />
                                            <TextBlock Grid.Row="1" Margin="0,4" Foreground="{DynamicResource TextSecondaryBrush}" Text="IP" />
                                            <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,4" Text="{Binding SelectedDevice.IpAddress}" />
                                            <TextBlock Grid.Row="2" Margin="0,4" Foreground="{DynamicResource TextSecondaryBrush}" Text="MAC" />
                                            <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,4" Text="{Binding SelectedDevice.MacAddress}" />
                                            <TextBlock Grid.Row="3" Margin="0,4" Foreground="{DynamicResource TextSecondaryBrush}" Text="Entidade do prefixo IEEE" />
                                            <TextBlock Grid.Row="3" Grid.Column="1" Margin="0,4" Text="{Binding SelectedDevice.Manufacturer}" TextWrapping="Wrap" />
                                            <TextBlock Grid.Row="4" Margin="0,4" Foreground="{DynamicResource TextSecondaryBrush}" Text="SO provável" />
                                            <TextBlock Grid.Row="4" Grid.Column="1" Margin="0,4" Text="{Binding SelectedDevice.OsGuess}" TextWrapping="Wrap" />
                                            <TextBlock Grid.Row="5" Margin="0,4" Foreground="{DynamicResource TextSecondaryBrush}" Text="Ping / TTL" />
                                            <TextBlock Grid.Row="5" Grid.Column="1" Margin="0,4">
                                                <Run Text="{Binding SelectedDevice.ResponseTime, Mode=OneWay}" /><Run Text=" · TTL " /><Run Text="{Binding SelectedDevice.ReplyTtl, Mode=OneWay}" />
                                            </TextBlock>
                                        </Grid>

                                        <Separator Margin="0,14" />
                                        <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Text="AÇÕES SEGURAS" />
                                        <WrapPanel Margin="0,8,0,0">
                                            <Button Margin="0,0,6,6" Style="{StaticResource CompactButtonStyle}" Command="{Binding CopyIpCommand}" Content="Copiar IP" />
                                            <Button Margin="0,0,6,6" Style="{StaticResource CompactButtonStyle}" Command="{Binding CopyMacCommand}" Content="Copiar MAC" />
                                            <Button Margin="0,0,6,6" Style="{StaticResource CompactButtonStyle}" Command="{Binding OpenWebCommand}" Content="Abrir Web" />
                                            <Button Margin="0,0,6,6" Style="{StaticResource CompactButtonStyle}" Command="{Binding OpenExplorerCommand}" Content="Explorador" />
                                            <Button Margin="0,0,6,6" Style="{StaticResource CompactButtonStyle}" Command="{Binding PingCommand}" Content="Ping" />
                                            <Button Margin="0,0,6,6" Style="{StaticResource CompactButtonStyle}" Command="{Binding TracerouteCommand}" Content="Tracert" />
                                            <Button Margin="0,0,6,6" Style="{StaticResource CompactButtonStyle}" Command="{Binding RemoteDesktopCommand}" Content="RDP" />
                                            <Button Margin="0,0,6,6" Style="{StaticResource CompactButtonStyle}" Command="{Binding WakeOnLanCommand}" Content="Wake-on-LAN" />
                                        </WrapPanel>
                                        <TextBlock Margin="0,4,0,0"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   Text="As ações só são ativadas quando o serviço correspondente foi detetado." />
                                        <Separator Margin="0,14" />
                                        <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Text="PREFERÊNCIAS DO DISPOSITIVO" />
                                        <CheckBox Margin="0,9,0,5"
                                                  IsChecked="{Binding SelectedDevice.IsFavorite}"
                                                  Content="Marcar como favorito"
                                                  AutomationProperties.Name="Marcar dispositivo como favorito" />
                                        <Label Content="Nome personalizado" />
                                        <TextBox Text="{Binding SelectedDevice.Alias, UpdateSourceTrigger=PropertyChanged}"
                                                 AutomationProperties.Name="Nome personalizado do dispositivo" />
                                        <Label Margin="0,9,0,0" Content="Notas" />
                                        <TextBox MinHeight="68"
                                                 AcceptsReturn="True"
                                                 TextWrapping="Wrap"
                                                 VerticalContentAlignment="Top"
                                                 Text="{Binding SelectedDevice.Notes, UpdateSourceTrigger=PropertyChanged}"
                                                 AutomationProperties.Name="Notas do dispositivo" />
                                        <Button Margin="0,9,0,0"
                                                HorizontalAlignment="Left"
                                                Style="{StaticResource CompactButtonStyle}"
                                                Command="{Binding SaveDeviceMetadataCommand}"
                                                Content="Guardar preferências"
                                                AutomationProperties.Name="Guardar preferências do dispositivo" />
                                    </StackPanel>
                                </ScrollViewer>
                            </TabItem>

                            <TabItem Header="Serviços">
                                <Grid Margin="8">
                                    <ListView ItemsSource="{Binding SelectedDevice.Ports}"
                                              ScrollViewer.CanContentScroll="True"
                                              VirtualizingPanel.IsVirtualizing="True"
                                              VirtualizingPanel.VirtualizationMode="Recycling"
                                              AutomationProperties.Name="Portas e serviços abertos">
                                        <ListView.View>
                                            <GridView>
                                                <GridViewColumn Width="58" Header="Porta" DisplayMemberBinding="{Binding Port}" />
                                                <GridViewColumn Width="62" Header="Proto." DisplayMemberBinding="{Binding Protocol}" />
                                                <GridViewColumn Width="112" Header="Serviço" DisplayMemberBinding="{Binding ServiceName}" />
                                                <GridViewColumn Width="190" Header="TLS" DisplayMemberBinding="{Binding TlsStatusDisplay}" />
                                            </GridView>
                                        </ListView.View>
                                        <ListView.ItemContainerStyle>
                                            <Style TargetType="{x:Type ListViewItem}">
                                                <Setter Property="ToolTip" Value="{Binding Banner}" />
                                                <Setter Property="Padding" Value="3" />
                                            </Style>
                                        </ListView.ItemContainerStyle>
                                    </ListView>
                                    <TextBlock HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               Text="Não foram detetadas portas TCP abertas."
                                               IsHitTestVisible="False">
                                        <TextBlock.Style>
                                            <Style TargetType="{x:Type TextBlock}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedDevice.HasPorts}" Value="False">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </TabItem>

                            <TabItem Header="Segurança">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel Margin="12">
                                        <Border Padding="12"
                                                Background="{Binding SelectedDevice.RiskLevel, Converter={StaticResource RiskToBrushConverter}}"
                                                CornerRadius="7">
                                            <StackPanel>
                                                <TextBlock FontWeight="SemiBold"
                                                           Foreground="{Binding SelectedDevice.RiskLevel, Converter={StaticResource RiskToForegroundConverter}}"
                                                           Text="{Binding SelectedDevice.RiskLevel, StringFormat=Nível de risco: {0}}" />
                                                <TextBlock Margin="0,4,0,0"
                                                           FontSize="11"
                                                           Foreground="{Binding SelectedDevice.RiskLevel, Converter={StaticResource RiskToForegroundConverter}}"
                                                           Text="Avaliação heurística baseada nos serviços observados." />
                                            </StackPanel>
                                        </Border>
                                        <ItemsControl Margin="0,12,0,0" ItemsSource="{Binding SelectedDevice.SecurityFindings}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Margin="0,0,0,7" Padding="10" Background="{DynamicResource SurfaceMutedBrush}" CornerRadius="6">
                                                        <TextBlock Text="{Binding StringFormat=⚠  {0}}" TextWrapping="Wrap" />
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Margin="0,15,0,0"
                                                   HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   Text="Não foram gerados alertas para este dispositivo.">
                                            <TextBlock.Style>
                                                <Style TargetType="{x:Type TextBlock}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedDevice.HasSecurityFindings}" Value="False">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </ScrollViewer>
                            </TabItem>

                            <TabItem Header="Rede">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel Margin="12">
                                        <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Text="TOPOLOGIA E EVIDÊNCIA" />
                                        <Grid Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="125" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Margin="0,4" Foreground="{DynamicResource TextSecondaryBrush}" Text="Segmento L2" />
                                            <TextBlock Grid.Column="1" Margin="0,4" Text="{Binding SelectedDevice.Layer2}" TextWrapping="Wrap" />
                                            <TextBlock Grid.Row="1" Margin="0,4" Foreground="{DynamicResource TextSecondaryBrush}" Text="Confiança L2" />
                                            <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,4" Text="{Binding SelectedDevice.Layer2Confidence}" />
                                            <TextBlock Grid.Row="2" Margin="0,4" Foreground="{DynamicResource TextSecondaryBrush}" Text="VLAN" />
                                            <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,4" Text="{Binding SelectedDevice.Vlan}" TextWrapping="Wrap" />
                                            <TextBlock Grid.Row="3" Margin="0,4" Foreground="{DynamicResource TextSecondaryBrush}" Text="Confiança VLAN" />
                                            <TextBlock Grid.Row="3" Grid.Column="1" Margin="0,4" Text="{Binding SelectedDevice.VlanConfidence}" />
                                            <TextBlock Grid.Row="4" Margin="0,4" Foreground="{DynamicResource TextSecondaryBrush}" Text="Switch físico" />
                                            <TextBlock Grid.Row="4" Grid.Column="1" Margin="0,4" Text="{Binding SelectedDevice.SameSwitch}" TextWrapping="Wrap" />
                                            <TextBlock Grid.Row="5" Margin="0,4" Foreground="{DynamicResource TextSecondaryBrush}" Text="Descoberta" />
                                            <TextBlock Grid.Row="5" Grid.Column="1" Margin="0,4" Text="{Binding SelectedDevice.Discovery}" TextWrapping="Wrap" />
                                            <TextBlock Grid.Row="6" Margin="0,4" Foreground="{DynamicResource TextSecondaryBrush}" Text="NetBIOS" />
                                            <TextBlock Grid.Row="6" Grid.Column="1" Margin="0,4">
                                                <Run Text="{Binding SelectedDevice.NetBiosName, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding SelectedDevice.Workgroup, Mode=OneWay}" />
                                            </TextBlock>
                                            <TextBlock Grid.Row="7" Margin="0,4" Foreground="{DynamicResource TextSecondaryBrush}" Text="WS-Discovery" />
                                            <TextBlock Grid.Row="7" Grid.Column="1" Margin="0,4" Text="{Binding SelectedDevice.WsDiscovery}" TextWrapping="Wrap" />
                                            <TextBlock Grid.Row="8" Margin="0,4" Foreground="{DynamicResource TextSecondaryBrush}" Text="Wi-Fi local" />
                                            <TextBlock Grid.Row="8" Grid.Column="1" Margin="0,4" Text="{Binding SelectedInterfaceWifi}" TextWrapping="Wrap" />
                                        </Grid>
                                        <Border Margin="0,12,0,0" Padding="10" Background="{DynamicResource SurfaceMutedBrush}" CornerRadius="6">
                                            <TextBlock Text="{Binding SelectedDevice.SwitchEvidence}" TextWrapping="Wrap" />
                                        </Border>
                                        <Separator Margin="0,14" />
                                        <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Text="PROTOCOLOS OBSERVADOS OU INFERIDOS" />
                                        <TextBlock Margin="0,7,0,0" Text="{Binding SelectedDevice.Protocols}" TextWrapping="Wrap" />
                                        <TextBlock Margin="0,5,0,0" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Text="Esta lista resulta de descoberta, portas e banners; não equivale a captura integral de pacotes." TextWrapping="Wrap" />
                                    </StackPanel>
                                </ScrollViewer>
                            </TabItem>

                            <TabItem Header="Histórico">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel Margin="12">
                                        <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Text="PRESENÇA NA REDE" />
                                        <Grid Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="100" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Margin="0,4" Foreground="{DynamicResource TextSecondaryBrush}" Text="Estado" />
                                            <TextBlock Grid.Column="1" Margin="0,4" Text="{Binding SelectedDevice.History}" />
                                            <TextBlock Grid.Row="1" Margin="0,4" Foreground="{DynamicResource TextSecondaryBrush}" Text="Primeira vez" />
                                            <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,4" Text="{Binding SelectedDevice.FirstSeen}" />
                                            <TextBlock Grid.Row="2" Margin="0,4" Foreground="{DynamicResource TextSecondaryBrush}" Text="Última vez" />
                                            <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,4" Text="{Binding SelectedDevice.LastSeen}" />
                                        </Grid>
                                        <Separator Margin="0,14" />
                                        <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Text="ALTERAÇÕES DESDE O SCAN ANTERIOR" />
                                        <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding SelectedDevice.Changes}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Margin="0,3" Text="{Binding StringFormat=• {0}}" TextWrapping="Wrap" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Margin="0,12,0,0"
                                                   HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   Text="Sem alterações registadas.">
                                            <TextBlock.Style>
                                                <Style TargetType="{x:Type TextBlock}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedDevice.HasChanges}" Value="False">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </ScrollViewer>
                            </TabItem>
                        </TabControl>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="5"
                Margin="2,10,2,0"
                Padding="2,0"
                Background="Transparent"
                AutomationProperties.LiveSetting="Polite">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="7" Height="7" Margin="0,0,8,0" VerticalAlignment="Center" Fill="{DynamicResource AccentBrush}" />
                    <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding StatusMessage}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <TextBlock Grid.Column="1"
                           Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Text="Uso autorizado em redes próprias ou administradas" />
            </Grid>
        </Border>
    </Grid>
</Window>

