<Window x:Class="LocalNetworkScanner.Wpf.TopologyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:LocalNetworkScanner.Wpf.Controls"
        xmlns:loc="clr-namespace:LocalNetworkScanner.Wpf.Services"
        Title="Topologia da rede — Local Network Scanner"
        Width="1240"
        Height="760"
        MinWidth="720"
        MinHeight="480"
        Background="{DynamicResource WindowBackgroundBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        TextOptions.TextFormattingMode="Display"
        WindowStartupLocation="CenterOwner"
        Loaded="OnLoaded"
        PreviewKeyDown="OnPreviewKeyDown"
        AutomationProperties.Name="Topologia do scan atual"
        loc:LocalizationService.IsEnabled="True">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Margin="2,0,2,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock FontFamily="Segoe UI Variable Display, Segoe UI"
                               FontSize="24"
                               FontWeight="SemiBold"
                               Text="Topologia do scan" />
                    <TextBlock Margin="0,3,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="{Binding TopologyMap.NetworkCidr, Converter={StaticResource LocalizedFormatConverter}, ConverterParameter=Mapa opcional da rede |}" />
                </StackPanel>
                <Button Grid.Column="1"
                        Margin="12,0,0,0"
                        VerticalAlignment="Center"
                        Style="{StaticResource IconButtonStyle}"
                        Click="OnCloseClick"
                        ToolTip="Fechar topologia (Escape ou Alt+F4)"
                        AutomationProperties.Name="Fechar janela de topologia"
                        AutomationProperties.HelpText="Fecha apenas a janela de topologia. Atalhos Escape e Alt+F4.">
                    <TextBlock Style="{StaticResource IconGlyphStyle}" Text="&#xE8BB;" />
                </Button>
            </Grid>

            <ScrollViewer Grid.Row="1"
                          Margin="0,9,0,0"
                          HorizontalContentAlignment="Right"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled"
                          AutomationProperties.Name="Ferramentas do mapa de topologia">
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button Margin="4,0"
                            MinWidth="34"
                            Style="{StaticResource CompactButtonStyle}"
                            Click="OnZoomOutTopologyClick"
                            Content="−"
                            ToolTip="Reduzir a topologia (tecla −)"
                            AutomationProperties.Name="Reduzir topologia" />
                    <TextBlock x:Name="TopologyZoomText"
                               MinWidth="48"
                               Margin="2,0"
                               VerticalAlignment="Center"
                               TextAlignment="Center"
                               FontWeight="SemiBold"
                               AutomationProperties.LiveSetting="Polite"
                               AutomationProperties.Name="Nível de ampliação da topologia"
                               Text="100%" />
                    <Button Margin="4,0"
                            MinWidth="34"
                            Style="{StaticResource CompactButtonStyle}"
                            Click="OnZoomInTopologyClick"
                            Content="+"
                            ToolTip="Ampliar a topologia (tecla +)"
                            AutomationProperties.Name="Ampliar topologia" />
                    <Button Margin="4,0"
                            Style="{StaticResource CompactButtonStyle}"
                            Click="OnFitTopologyClick"
                            Content="Ajustar"
                            ToolTip="Enquadrar todos os nós (Home)"
                            AutomationProperties.Name="Ajustar topologia à área visível" />
                    <Button Margin="4,0"
                            Style="{StaticResource CompactButtonStyle}"
                            Click="OnResetTopologyClick"
                            Content="100%"
                            ToolTip="Repor ampliação a 100 por cento"
                            AutomationProperties.Name="Repor ampliação da topologia" />
                    <Button Margin="4,0"
                            Style="{StaticResource CompactButtonStyle}"
                            Click="OnExportTopologyPngClick"
                            Content="Guardar PNG"
                            ToolTip="Guardar exatamente o mapa visível como imagem PNG"
                            AutomationProperties.Name="Guardar mapa de topologia em PNG" />
                    <Button Margin="4,0"
                            Style="{StaticResource CompactButtonStyle}"
                            Command="{Binding ExportGraphMlCommand}"
                            Content="GraphML"
                            ToolTip="Guardar topologia estruturada para Gephi, yEd ou ferramentas compatíveis"
                            AutomationProperties.Name="Guardar topologia em GraphML" />
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Border Grid.Row="1"
                Margin="0,0,0,10"
                Padding="12,8"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           Text="Mostrar" />
                <ComboBox x:Name="TopologyFilterComboBox"
                          Grid.Column="1"
                          Width="170"
                          Margin="9,0,0,0"
                          SelectedIndex="0"
                          SelectionChanged="OnTopologyFilterChanged"
                          AutomationProperties.Name="Filtrar nós da topologia">
                    <ComboBoxItem Content="Todos" Tag="All" />
                    <ComboBoxItem Content="Infraestrutura" Tag="Infrastructure" />
                    <ComboBoxItem Content="Clientes" Tag="Clients" />
                    <ComboBoxItem Content="Alertas" Tag="Alerts" />
                </ComboBox>
                <TextBlock x:Name="TopologySummaryText"
                           Grid.Column="2"
                           Grid.ColumnSpan="3"
                           Margin="14,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextTrimming="CharacterEllipsis"
                           AutomationProperties.LiveSetting="Polite"
                           AutomationProperties.Name="Resumo da topologia"
                           Text="A preparar a topologia..." />

                <TextBlock Grid.Row="1"
                           Margin="0,10,0,0"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           Text="Localizar" />
                <TextBox x:Name="TopologySearchTextBox"
                         Grid.Row="1"
                         Grid.Column="1"
                         Grid.ColumnSpan="2"
                         MinWidth="140"
                         Margin="9,10,0,0"
                         PreviewKeyDown="OnTopologySearchKeyDown"
                         AutomationProperties.Name="Localizar nó na topologia"
                         AutomationProperties.HelpText="Escreve parte do nome, IP, MAC, tipo ou fabricante e prime Enter. Repete Enter ou usa F3 para percorrer as correspondências." />
                <Button x:Name="FindTopologyNodeButton"
                        Grid.Row="1"
                        Grid.Column="3"
                        Margin="8,10,0,0"
                        Style="{StaticResource IconButtonStyle}"
                        Click="OnFindTopologyNodeClick"
                        ToolTip="Localizar e centrar nó (Enter ou F3)"
                        AutomationProperties.Name="Localizar e centrar nó na topologia">
                    <TextBlock Style="{StaticResource IconGlyphStyle}" Text="&#xE721;" />
                </Button>
                <Button x:Name="ClearTopologySearchButton"
                        Grid.Row="1"
                        Grid.Column="4"
                        Margin="8,10,0,0"
                        Style="{StaticResource IconButtonStyle}"
                        Click="OnClearTopologySearchClick"
                        ToolTip="Limpar pesquisa de nós"
                        AutomationProperties.Name="Limpar pesquisa de nós">
                    <TextBlock Style="{StaticResource IconGlyphStyle}" Text="&#xE711;" />
                </Button>
                <TextBlock x:Name="TopologySearchStatusText"
                           Grid.Row="2"
                           Grid.ColumnSpan="5"
                           Margin="0,7,0,0"
                           FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap"
                           Visibility="Collapsed"
                           AutomationProperties.LiveSetting="Polite"
                           AutomationProperties.Name="Estado da pesquisa na topologia" />
            </Grid>
        </Border>

        <TabControl x:Name="TopologyViews"
                    Grid.Row="2"
                    Margin="0"
                    SelectionChanged="OnTopologyViewChanged"
                    AutomationProperties.Name="Vistas da topologia">
            <TabItem Header="Mapa visual">
                <Border Margin="0,4,0,0"
                        Background="{DynamicResource SurfaceMutedBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="9">
                    <controls:NetworkTopologyControl x:Name="TopologyGraph"
                                                     Map="{Binding TopologyMap}"
                                                     SelectedNode="{Binding SelectedTopologyNode, Mode=TwoWay}"
                                                     MinHeight="100" />
                </Border>
            </TabItem>

            <TabItem Header="Tabela acessível">
                <Grid Margin="0,7,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="2*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Margin="2,0,0,5"
                               FontWeight="SemiBold"
                               Text="Nós visíveis" />
                    <DataGrid x:Name="TopologyNodesTable"
                              Grid.Row="1"
                              IsReadOnly="True"
                              SelectionChanged="OnTopologyNodeTableSelectionChanged"
                              AutomationProperties.Name="Nós visíveis na topologia">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Camada" Width="145" Binding="{Binding Kind}" />
                            <DataGridTextColumn Header="Nome" Width="*" Binding="{Binding Label}" />
                            <DataGridTextColumn Header="IP" Width="125" Binding="{Binding IpAddress}" />
                            <DataGridTextColumn Header="Estado" Width="105" Binding="{Binding State}" />
                            <DataGridTextColumn Header="Risco" Width="90" Binding="{Binding Risk}" />
                            <DataGridTextColumn Header="VLAN" Width="90" Binding="{Binding Vlan}" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Grid.Row="2"
                               Margin="2,10,0,5"
                               FontWeight="SemiBold"
                               Text="Ligações e respetiva evidência" />
                    <DataGrid x:Name="TopologyEdgesTable"
                              Grid.Row="3"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              AutomationProperties.Name="Ligações e evidência da topologia">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Origem" Width="*" Binding="{Binding Source}" />
                            <DataGridTextColumn Header="Destino" Width="*" Binding="{Binding Target}" />
                            <DataGridTextColumn Header="Tipo" Width="140" Binding="{Binding Kind}" />
                            <DataGridTextColumn Header="Confiança" Width="100" Binding="{Binding Confidence}" />
                            <DataGridTextColumn Header="Evidência" Width="2*" Binding="{Binding Evidence}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>

        <Grid Grid.Row="3" Margin="2,9,2,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <WrapPanel>
                    <TextBlock Margin="0,0,16,2" FontSize="11" FontWeight="SemiBold" Text="LEGENDA" />
                    <TextBlock Margin="0,0,16,2" FontSize="11" Text="━━━━ ARP / L2 observado" />
                    <TextBlock Margin="0,0,16,2" FontSize="11" Text="━ ━ FDB / SNMP" />
                    <TextBlock Margin="0,0,16,2" FontSize="11" Text="···· Alcance IP inferido" />
                    <TextBlock Margin="0,0,16,2" FontSize="11" Text="━━ Rota / LLDP" />
                </WrapPanel>
                <TextBlock FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap"
                           Text="Roda: zoom · arrastar o fundo: mover · Tab: percorrer nós · +/−: zoom · setas: mover · Home: ajustar · Ctrl+F/F3: localizar · Ctrl+1/Ctrl+2: mapa/tabela. A FDB mostra onde o MAC foi aprendido, não prova a ligação física." />
                <Expander Margin="0,3,0,0"
                          Header="Notas e limites do mapa"
                          AutomationProperties.Name="Notas e limites técnicos da topologia">
                    <ItemsControl Margin="0,3,0,0" ItemsSource="{Binding TopologyMap.Warnings}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Margin="0,1"
                                           FontSize="11"
                                           Foreground="{DynamicResource WarningBrush}"
                                           Text="{Binding Path=., Converter={StaticResource LocalizedFormatConverter}, ConverterParameter=• |}"
                                           TextWrapping="Wrap" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Expander>
            </StackPanel>

            <Border x:Name="TopologySelectionRegion"
                    Grid.Column="1"
                    MinWidth="265"
                    MaxWidth="400"
                    Margin="18,0,0,0"
                    Padding="11,8"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="7"
                    AutomationProperties.LiveSetting="Polite"
                    AutomationProperties.Name="Nenhum nó selecionado">
                <StackPanel>
                    <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Text="NÓ SELECIONADO" />
                    <TextBlock Margin="0,3,0,0" FontWeight="SemiBold" Text="{Binding SelectedTopologyNode.Label, TargetNullValue=Nenhum nó selecionado}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Margin="0,2,0,0" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding SelectedTopologyNode.Subtitle}" TextTrimming="CharacterEllipsis" />
                    <WrapPanel Margin="0,3,0,0">
                        <TextBlock Margin="0,0,12,0" FontSize="11" Text="{Binding SelectedTopologyNode.IpAddress, Converter={StaticResource LocalizedFormatConverter}, ConverterParameter=IP: |}" />
                        <TextBlock Margin="0,0,12,0" FontSize="11" Text="{Binding SelectedTopologyNode.VlanId, Converter={StaticResource LocalizedFormatConverter}, ConverterParameter=VLAN: |}" />
                        <TextBlock FontSize="11" Text="{Binding SelectedTopologyNode.RiskLevel, Converter={StaticResource LocalizedFormatConverter}, ConverterParameter=Risco: |}" />
                    </WrapPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>

