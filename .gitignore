# Build and publish output
**/bin/
**/obj/
artifacts/
publish/
TestResults/
coverage/
coverage.*
*.trx
*.coverage
*.coveragexml

# Local root app entry (materialized by scripts/update-local-app.ps1)
/app/LocalNetworkScanner.exe
/app/LocalNetworkScanner.lnk
/app/APP-BUILD.json
/app/.update-*.tmp
/app/.update.lock

# Visual Studio, VS Code and JetBrains
.vs/
.vscode/
.idea/
*.suo
*.user
*.userosscache
*.sln.docstates
*.rsuser
*.DotSettings.user

# NuGet and local tooling
packages/
*.nupkg
*.snupkg
.tools/

# Logs, diagnostics and temporary files
*.log
*.tmp
*.temp
*.bak
*.dmp
*.etl
*.binlog

# Local configuration and secrets
.env
.env.*
!.env.example
*.pfx
*.p12
*.key
*.snk
secrets.json

# Private test certificate material (only the public .crt is versioned)
/crt/*.pfx
/crt/*.p12
/crt/*.pem
/crt/*.key
/crt/*.pvk

# Operating-system files
Thumbs.db
Desktop.ini
.DS_Store

